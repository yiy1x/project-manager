{
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "stage", "progress", "blocker", "next", "next_plan", "confirmation_plan", "events"],
  "properties": {
    "goal": {"type": "string", "minLength": 1, "maxLength": 500},
    "stage": {"type": "string", "minLength": 1, "maxLength": 60},
    "progress": {"type": "string", "minLength": 1, "maxLength": 2400},
    "blocker": {"type": "string", "minLength": 1, "maxLength": 1000},
    "next": {"type": "string", "minLength": 1, "maxLength": 1000},
    "next_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "points"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 40},
        "points": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "text"],
            "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 4}, "text": {"type": "string", "minLength": 1, "maxLength": 48}}
          }
        }
      }
    },
    "confirmation_plan": {
      "type": "object", "additionalProperties": false, "required": ["summary", "points"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 40},
        "points": {
          "type": "array", "minItems": 0, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "text"],
            "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 4}, "text": {"type": "string", "minLength": 1, "maxLength": 48}}
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "kind", "focus", "detail", "points", "evidence_ids"],
        "properties": {
          "summary": {"type": "string", "minLength": 1, "maxLength": 40},
          "kind": {"type": "string", "enum": ["想法", "调研", "决策", "实现", "验证", "阻塞"]},
          "focus": {"type": "string", "minLength": 1, "maxLength": 40},
          "detail": {"type": "string", "minLength": 1, "maxLength": 1200},
          "points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "text"],
              "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 4}, "text": {"type": "string", "minLength": 1, "maxLength": 48}}
            }
          },
          "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string"}}
        }
      }
    }
  }
}
